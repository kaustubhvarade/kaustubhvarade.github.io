---
interface Props {
  cover?: string;
  motif: string;
}

const { cover, motif } = Astro.props;
const isImage = cover?.startsWith('/');
const key = (!isImage && cover) || motif;
const BG: Record<string, string> = {
  layers: '#FBF1D6', phone: '#FDE3D3', card: '#DDF1E4', platform: '#DCE8FB', system: '#DDF1E4',
  recon: '#FBF1D6', scanner: '#E8E1F7', browser: '#FCE0DC', mic: '#FCE0DC',
};
---
{isImage ? (
  <img class="cover" src={cover} alt="" loading="lazy" />
) : (
  <div class="cover" style={`background: ${BG[key] ?? '#FBF1D6'}`}>
    <svg viewBox="0 0 320 180" aria-hidden="true" fill="none" stroke="#111111" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      {key === 'layers' && (
        <g>
          <polygon points="160,84 240,119 160,154 80,119" fill="#ffffff" />
          <polygon points="160,62 240,97 160,132 80,97" fill="#ffffff" />
          <polygon points="160,40 240,75 160,110 80,75" fill="#F6C343" />
          <line x1="120" y1="75" x2="160" y2="92" />
          <line x1="160" y1="58" x2="200" y2="75" />
        </g>
      )}
      {key === 'phone' && (
        <g>
          <rect x="118" y="20" width="76" height="144" rx="14" fill="#ffffff" />
          <line x1="146" y1="34" x2="166" y2="34" />
          <circle cx="156" cy="92" r="24" fill="#F28C28" />
          <polyline points="145,92 153,100 168,84" stroke-width="4" />
          <line x1="138" y1="134" x2="174" y2="134" />
          <circle cx="246" cy="62" r="24" fill="#ffffff" />
          <polyline points="246,48 246,62 256,70" />
          <line x1="60" y1="80" x2="98" y2="80" />
          <line x1="70" y1="104" x2="98" y2="104" />
        </g>
      )}
      {key === 'card' && (
        <g>
          <rect x="90" y="40" width="160" height="102" rx="12" fill="#3BAA6E" />
          <line x1="90" y1="64" x2="250" y2="64" stroke-width="8" />
          <rect x="108" y="84" width="28" height="22" rx="4" fill="#ffffff" />
          <line x1="34" y1="70" x2="70" y2="70" />
          <line x1="24" y1="96" x2="70" y2="96" />
          <line x1="40" y1="122" x2="70" y2="122" />
        </g>
      )}
      {key === 'platform' && (
        <g>
          <rect x="70" y="112" width="60" height="38" rx="3" fill="#ffffff" />
          <rect x="130" y="112" width="60" height="38" rx="3" fill="#6C9BF2" />
          <rect x="190" y="112" width="60" height="38" rx="3" fill="#ffffff" />
          <rect x="100" y="74" width="60" height="38" rx="3" fill="#ffffff" />
          <rect x="160" y="74" width="60" height="38" rx="3" fill="#ffffff" />
          <rect x="130" y="36" width="60" height="38" rx="3" fill="#ffffff" />
          <line x1="40" y1="150" x2="280" y2="150" stroke-width="5" />
        </g>
      )}
      {key === 'system' && (
        <g>
          <rect x="34" y="72" width="64" height="38" rx="6" fill="#ffffff" />
          <rect x="128" y="30" width="64" height="38" rx="6" fill="#3BAA6E" />
          <rect x="128" y="114" width="64" height="38" rx="6" fill="#ffffff" />
          <rect x="222" y="72" width="64" height="38" rx="6" fill="#ffffff" />
          <polyline points="98,91 113,91 113,49 124,49" />
          <polyline points="98,91 113,91 113,133 124,133" />
          <polyline points="192,49 207,49 207,91 218,91" />
          <polyline points="192,133 207,133 207,91" />
        </g>
      )}
      {key === 'recon' && (
        <g>
          <rect x="56" y="36" width="84" height="108" rx="6" fill="#ffffff" />
          <rect x="180" y="36" width="84" height="108" rx="6" fill="#F6C343" />
          <line x1="70" y1="64" x2="124" y2="64" />
          <line x1="70" y1="88" x2="124" y2="88" />
          <line x1="70" y1="112" x2="110" y2="112" />
          <line x1="196" y1="64" x2="250" y2="64" />
          <line x1="196" y1="88" x2="250" y2="88" />
          <line x1="196" y1="112" x2="236" y2="112" />
          <line x1="140" y1="64" x2="180" y2="64" stroke-dasharray="5 6" />
          <line x1="140" y1="88" x2="180" y2="88" stroke-dasharray="5 6" />
          <circle cx="160" cy="146" r="18" fill="#ffffff" />
          <polyline points="151,146 158,153 170,139" />
        </g>
      )}
      {key === 'scanner' && (
        <g>
          <rect x="84" y="26" width="110" height="132" rx="6" fill="#ffffff" />
          <line x1="100" y1="52" x2="178" y2="52" />
          <line x1="100" y1="74" x2="178" y2="74" />
          <line x1="100" y1="96" x2="150" y2="96" />
          <line x1="100" y1="118" x2="140" y2="118" />
          <circle cx="202" cy="104" r="34" fill="#6C9BF2" />
          <line x1="226" y1="128" x2="260" y2="162" stroke-width="9" />
        </g>
      )}
      {key === 'browser' && (
        <g>
          <rect x="60" y="32" width="200" height="124" rx="10" fill="#ffffff" />
          <line x1="60" y1="58" x2="260" y2="58" />
          <circle cx="78" cy="45" r="4" fill="#F06A5B" />
          <circle cx="92" cy="45" r="4" fill="#F06A5B" />
          <circle cx="106" cy="45" r="4" fill="#F06A5B" />
          <polyline points="134,82 112,106 134,130" />
          <polyline points="186,82 208,106 186,130" />
          <line x1="168" y1="78" x2="152" y2="134" />
        </g>
      )}
      {key === 'mic' && (
        <g>
          <rect x="138" y="22" width="44" height="70" rx="22" fill="#F06A5B" />
          <line x1="148" y1="44" x2="172" y2="44" />
          <line x1="148" y1="58" x2="172" y2="58" />
          <path d="M124 70 a36 36 0 0 0 72 0" />
          <line x1="160" y1="106" x2="160" y2="140" />
          <line x1="128" y1="146" x2="192" y2="146" stroke-width="5" />
          <path d="M98 40 a40 40 0 0 0 0 52" />
          <path d="M222 40 a40 40 0 0 1 0 52" />
        </g>
      )}
    </svg>
  </div>
)}
